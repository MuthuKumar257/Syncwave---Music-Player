# =============================================================================
# SyncWave Music Player — Root Monorepo Environment Configuration Schema
# =============================================================================
# This repository comprises three application targets:
#   1. server/  — Node.js / Express backend with Supabase PostgreSQL & Auth
#   2. web/     — React / Vite frontend
#   3. mobile/  — React Native cross-platform application
#
# Refer to the individual platform templates for granular environment setups:
#   - server/.env.example
#   - web/.env.example
#   - mobile/.env.example
# =============================================================================

# Server Port (Default: 3001)
PORT=3001
NODE_ENV=production

# JSON Web Token Secret (generate with openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_hex_32_characters_minimum

# Allowed Frontend Origins for CORS
FRONTEND_URL=http://localhost:3000

# Administrative API Key (required in production for maintenance operations)
ADMIN_API_KEY=your_admin_api_secret_key

# Supabase Persistent Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# SMTP / Email OTP Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM=SyncWave Security <no-reply@syncwave.app>
OTP_EXPIRY_MINUTES=3
