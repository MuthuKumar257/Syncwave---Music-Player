# =============================================================================
# SyncWave Backend — Environment Configuration Schema
# =============================================================================
# Copy this file to .env and replace placeholders with production secrets.
# NEVER commit the real .env file into source control.
# =============================================================================

# Server Port (Default: 3001)
PORT=3001

# Application Environment (development | production | test)
NODE_ENV=production

# JSON Web Token Secret (Generate with: openssl rand -hex 32)
# Required for signing auth session tokens
JWT_SECRET=your_jwt_secret_hex_32_characters_minimum

# Allowed Frontend Origin for CORS headers (e.g. https://syncwave.app or http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Persistent History & Cloud Storage
# -----------------------------------------------------------------------------
# Project URL from Supabase dashboard (Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (secret, server-side only) or Anon Key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key

# -----------------------------------------------------------------------------
# Google OAuth 2.0 Single Sign-On
# -----------------------------------------------------------------------------
# Google Cloud Console Web Client ID & Secret for OAuth Sign-In
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Cloud Console Android Client ID (for Android native Google Sign-In)
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Email OTP Delivery (SMTP or Resend)
# -----------------------------------------------------------------------------
# SMTP Configuration (Gmail, SendGrid, Amazon SES, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM=SyncWave Security <no-reply@syncwave.app>

# Optional Resend API Alternative (if using Resend instead of SMTP)
# RESEND_API_KEY=re_your_resend_api_key

# -----------------------------------------------------------------------------
# OTP Verification Expiry
# -----------------------------------------------------------------------------
# OTP challenge expiration in minutes (Default: 3)
OTP_EXPIRY_MINUTES=3
