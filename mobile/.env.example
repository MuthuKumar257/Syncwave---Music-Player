# =============================================================================
# SyncWave Mobile — React Native Environment Configuration Template
# =============================================================================
# Only variables prefixed with EXPO_PUBLIC_ are bundled into client mobile binaries.
# NEVER put private server secrets, database credentials, or private keys here.
# =============================================================================

# SyncWave Backend API Base URL
# Android Emulator loopback is http://10.0.2.2:3001; iOS Simulator uses http://localhost:3001
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# Google Sign-In Client ID (Public client identifier only)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
