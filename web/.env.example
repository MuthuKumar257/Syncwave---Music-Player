# =============================================================================
# SyncWave Web — Client Environment Configuration Template
# =============================================================================
# Only variables prefixed with VITE_ are exposed to the browser client.
# NEVER put private server secrets, database credentials, or private keys here.
# =============================================================================

# SyncWave Backend API Base URL
VITE_API_URL=http://localhost:3001

# Google OAuth Web Client ID (Public client identifier only, never client secret)
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
